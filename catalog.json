    {
      "id": "element-picker",
      "name": "dsh-element-picker",
      "title": "元素 / 链接引用芯片",
      "category": "input",
      "status": "live",
      "summary": "把界面元素、链接、文件路径一键变成原生引用芯片；支持 DSH 界面、同源 iframe、侧栏浏览器页面，点击芯片可回到原元素",
      "problem": "想让模型改页面上某个按钮、引用某条链接或某个文件路径时，只能用一段文字去描述，模型经常指错地方。",
      "repo": "https://github.com/sakikoTGW/dsh-element-picker",
      "npm": "dsh-element-picker",
      "version": "0.10.3",
      "install": "dsh plugin --profile <profile> add dsh-element-picker",
      "engines": {
        "dsh": ">=0.2.0-rc.2 <0.3.0",
        "node": ">=20"
      },
      "license": "MIT",
      "since": "2026-10",
      "feedback": "https://github.com/sakikoTGW/dsh-element-picker/issues"
    },
    {
      "id": "plugin-resolver",
      "name": "dsh-plugin-resolver",
      "title": "插件安装助手",
      "category": "tooling",
      "status": "live",
      "summary": "一次工具调用把插件装对：搜目录、同名消歧、按当前内核选兼容版本、装完校验",
      "problem": "手工装插件要拉目录、猜同名来源、试版本、踩 npm 超时，最后还不知道装没装上；agent 侧约 45 步、20 分钟以上。",
      "repo": "https://github.com/sakikoTGW/dsh-plugin-resolver",
      "npm": "dsh-plugin-resolver",
      "version": "0.1.3",
      "install": "dsh plugin --profile <profile> add dsh-plugin-resolver",
      "engines": {
        "dsh": ">=0.2.0-rc.2 <0.3.0",
        "node": ">=20"
      },
      "license": "MIT",
      "since": "2026-10",
      "feedback": "https://github.com/sakikoTGW/dsh-plugin-resolver/issues"
    }
